{
  "name": "zoe-onboarding",
  "version": "1.0.0",
  "description": "ZOE Sleep Coaching Platform - 14-Day Onboarding Journey",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "cd server && npm run dev",
    "client": "cd client && npm run dev",
    "install:all": "npm install && cd server && npm install && cd ../client && npm install",
    "test": "npx tsx scripts/test-runner.ts --validate-all",
    "test:generate-users": "npx tsx scripts/test-runner.ts --generate-users",
    "test:generate-users:100": "npx tsx scripts/test-runner.ts --generate-users --count 100 --days 14",
    "test:gateways": "npx tsx scripts/test-runner.ts --validate-gateways",
    "test:questions": "npx tsx scripts/test-runner.ts --validate-questions",
    "test:formats": "npx tsx scripts/test-runner.ts --validate-formats",
    "test:data": "npx tsx scripts/test-runner.ts --validate-data",
    "test:stats": "npx tsx scripts/test-runner.ts --stats",
    "test:cleanup": "npx tsx scripts/test-runner.ts --cleanup",
    "test:clinical": "npx convex run clinicalScenarios:runAllClinicalScenarios",
    "test:cross-platform": "npx convex run crossPlatformValidator:runFullCrossPlatformValidation",
    "test:ios": "./scripts/run-ios-tests.sh",
    "test:ios:unit": "./scripts/run-ios-tests.sh unit",
    "test:ios:ui": "./scripts/run-ios-tests.sh ui",
    "test:ios:integration": "./scripts/run-ios-tests.sh integration",
    "test:ios:clinical": "./scripts/run-ios-tests.sh clinical",
    "test:ios:coverage": "./scripts/run-ios-tests.sh coverage",
    "test:all": "npm run test && npm run test:clinical && npm run test:cross-platform"
  },
  "keywords": [
    "zoe",
    "sleep",
    "onboarding"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2",
    "sharp": "^0.34.5",
    "tsx": "^4.19.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.71.2",
    "convex": "^1.29.0",
    "openai": "^6.8.1",
    "typescript": "^5.9.3"
  }
}
